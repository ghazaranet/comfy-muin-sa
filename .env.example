# ==============================================================================
# ComfyUI Docker Configuration
# ==============================================================================
# Copy this file to .env to customize environment variables:
#   cp .env.example .env

# Web interface port on host machine (default: 8188)
COMFYUI_PORT=8188

# NVIDIA GPUs visible to the container (e.g., 'all', '0', '0,1')
NVIDIA_VISIBLE_DEVICES=all

# Additional ComfyUI CLI arguments
# Common flags: --highvram, --lowvram, --novram, --preview-method auto, --cpu
COMMANDLINE_ARGS=

# PyTorch wheel repository index
# GPU (CUDA 12.4): https://download.pytorch.org/whl/cu124
# CPU fallback:   https://download.pytorch.org/whl/cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
